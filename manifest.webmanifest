{
  "id": "/",
  "name": "Webweave Nook",
  "short_name": "Nook",
  "description": "Gather pieces, weave connections, and keep a collection on your devices.",
  "lang": "en",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#fbf7f2",
  "theme_color": "#fbf7f2",
  "icons": [
    { "src": "/icons/nook-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/nook-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/nook-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title", "text": "text", "url": "url",
      "files": [{ "name": "images", "accept": ["image/png", "image/jpeg", "image/webp", "image/gif", ".png", ".jpg", ".jpeg", ".webp", ".gif"] }]
    }
  }
}
